    "Container FB Image": { "main": [[{ "node": "Extract Container ID", "type": "main", "index": 0 }]] },
    "Container IG Story Image": { "main": [[{ "node": "Extract Container ID", "type": "main", "index": 0 }]] },
    "Container IG Story Video": { "main": [[{ "node": "Extract Container ID", "type": "main", "index": 0 }]] },
    "Container FB Story Image": { "main": [[{ "node": "Extract Container ID", "type": "main", "index": 0 }]] },
    "Container IG Reel": { "main": [[{ "node": "Extract Container ID", "type": "main", "index": 0 }]] },
    "Container FB Reel": { "main": [[{ "node": "Extract Container ID", "type": "main", "index": 0 }]] },
    "Extract Container ID": { "main": [[{ "node": "Initial Wait", "type": "main", "index": 0 }]] },
    "Initial Wait": { "main": [[{ "node": "Check Processing Status", "type": "main", "index": 0 }]] },
    "Check Processing Status": { "main": [[{ "node": "Is Container Ready?", "type": "main", "index": 0 }]] },
    "Is Container Ready?": {
      "main": [
        [{ "node": "HTTPS vs FB Router", "type": "main", "index": 0 }],
        [{ "node": "Retry Wait", "type": "main", "index": 0 }]
      ]
    },
    "Retry Wait": { "main": [[{ "node": "Check Processing Status", "type": "main", "index": 0 }]] },
    "HTTPS vs FB Router": {
      "main": [
        [{ "node": "Publish via HTTPS (IG)", "type": "main", "index": 0 }],
        [{ "node": "Publish via Facebook SDK", "type": "main", "index": 0 }]
      ]
    },
    "Publish via HTTPS (IG)": { "main": [[{ "node": "Build Success Response", "type": "main", "index": 0 }]] },
    "Publish via Facebook SDK": { "main": [[{ "node": "Build Success Response", "type": "main", "index": 0 }]] },
    "Build Success Response": { "main": [[{ "node": "Respond to Webhook", "type": "main", "index": 0 }]] }
  },
  "settings": {
    "executionOrder": "v1",
    "binaryMode": "separate",
    "availableInMCP": true,
    "saveManualExecutions": true
  }
