        "options": { "queryParameters": { "parameter": [{ "name": "video_url", "value": "={{ $json.video_url }}" }, { "name": "media_type", "value": "REELS" }, { "name": "caption", "value": "={{ $json.caption }}" }] } }
      },
      "type": "n8n-nodes-base.facebookGraphApi",
      "typeVersion": 1,
      "position": [400, 1000],
      "id": "c-fb-reel",
      "name": "Container FB Reel"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "e1", "name": "container_id", "value": "={{ $json.id }}", "type": "string" },
            { "id": "e2", "name": "node", "value": "={{ $('Normalize Input').item.json.node }}", "type": "string" },
            { "id": "e3", "name": "post_type", "value": "={{ $('Normalize Input').item.json.post_type }}", "type": "string" },
            { "id": "e4", "name": "property_id", "value": "={{ $('Normalize Input').item.json.property_id }}", "type": "string" },
            { "id": "e5", "name": "schedule_id", "value": "={{ $('Normalize Input').item.json.schedule_id }}", "type": "string" }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [800, 400],
      "id": "extract-id",
      "name": "Extract Container ID"
    },
    {
      "parameters": { "waitAmount": 10, "unit": "seconds" },
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [1000, 400],
      "id": "init-wait",
      "name": "Initial Wait",
      "webhookId": "init-wait-wh-001"
    },
    {
      "parameters": {
        "url": "={{ 'https://graph.facebook.com/v23.0/' + $json.container_id }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpQueryAuth",
        "sendQuery": true,
        "queryParameters": { "parameters": [{ "name": "fields", "value": "status_code" }] },
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [1200, 400],
      "id": "check-status",
      "name": "Check Processing Status"
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 3 },
          "conditions": [{ "id": "ready-check", "leftValue": "={{ $json.status_code }}", "rightValue": "FINISHED", "operator": { "type": "string", "operation": "equals" } }],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [1400, 400],
      "id": "is-ready",
      "name": "Is Container Ready?"
    },
    {
      "parameters": { "waitAmount": 15, "unit": "seconds" },
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [1600, 550],
      "id": "retry-wait",
      "name": "Retry Wait",
      "webhookId": "retry-wait-wh-001"
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 3 },
          "conditions": [{ "id": "http-check", "leftValue": "={{ $json.post_type.split('_')[0] }}", "rightValue": "http", "operator": { "type": "string", "operation": "equals" } }],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [1600, 250],
      "id": "publish-router",
      "name": "HTTPS vs FB Router"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ 'https://graph.facebook.com/v23.0/' + $json.node + '/media_publish' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendQuery": true,
        "queryParameters": { "parameters": [{ "name": "creation_id", "value": "={{ $json.container_id }}" }] },
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [1900, 150],
      "id": "pub-https",
      "name": "Publish via HTTPS (IG)"
    },
    {
      "parameters": {
        "httpRequestMethod": "POST",
        "graphApiVersion": "v23.0",
        "node": "={{ $json.node }}",
        "edge": "media_publish",
        "options": { "queryParameters": { "parameter": [{ "name": "creation_id", "value": "={{ $json.container_id }}" }] } }
      },
      "type": "n8n-nodes-base.facebookGraphApi",
      "typeVersion": 1,
      "position": [1900, 400],
      "id": "pub-fb",
      "name": "Publish via Facebook SDK"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "resp-ok", "name": "response", "value": "={{ { \"success\": true, \"published\": true, \"post_id\": $json.id, \"post_type\": $(\"Normalize Input\").item.json.post_type, \"property_id\": $(\"Normalize Input\").item.json.property_id, \"schedule_id\": $(\"Normalize Input\").item.json.schedule_id, \"platform\": $(\"Normalize Input\").item.json.post_type.startsWith(\"fb\") ? \"facebook\" : \"instagram\", \"timestamp\": $now.toISO() } }}", "type": "object" }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [2100, 250],
      "id": "build-response",
      "name": "Build Success Response"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "resp-err", "name": "response", "value": "={{ { \"success\": false, \"published\": false, \"error\": \"Processing timeout - status: \" + $json.status_code, \"post_type\": $(\"Normalize Input\").item.json.post_type, \"property_id\": $(\"Normalize Input\").item.json.property_id, \"schedule_id\": $(\"Normalize Input\").item.json.schedule_id, \"timestamp\": $now.toISO() } }}", "type": "object" }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [1600, 750],
      "id": "build-error",
      "name": "Build Error Response"
    },
    {
      "parameters": {
        "statusCode": 200,
        "respondWith": "json",
        "responseBody": "={{ $json.response }}",
        "options": {}
      },
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.2,
      "position": [2300, 400],
      "id": "respond-wh",
      "name": "Respond to Webhook"
    }
  ],
  "connections": {
    "Webhook Trigger": { "main": [[{ "node": "Normalize Input", "type": "main", "index": 0 }]] },
    "Normalize Input": { "main": [[{ "node": "Content Router", "type": "main", "index": 0 }]] },
    "Content Router": {
