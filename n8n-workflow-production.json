        "options": { "queryParameters": { "parameter": [{ "name": "caption", "value": "={{ $json.caption }}" }, { "name": "image_url", "value": "={{ $json.image_url }}" }] } }
      },
      "type": "n8n-nodes-base.facebookGraphApi",
      "typeVersion": 1,
      "position": [400, 0],
      "id": "c-fb-img",
      "name": "Container FB Image"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ 'https://graph.facebook.com/v23.0/' + $json.node + '/media' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendQuery": true,
        "queryParameters": { "parameters": [{ "name": "media_type", "value": "STORIES" }, { "name": "image_url", "value": "={{ $json.image_url }}" }] },
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [400, 200],
      "id": "c-ig-story-img",
      "name": "Container IG Story Image"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ 'https://graph.facebook.com/v23.0/' + $json.node + '/media' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendQuery": true,
        "queryParameters": { "parameters": [{ "name": "media_type", "value": "STORIES" }, { "name": "video_url", "value": "={{ $json.video_url }}" }] },
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [400, 400],
      "id": "c-ig-story-vid",
      "name": "Container IG Story Video"
    },
    {
      "parameters": {
        "httpRequestMethod": "POST",
        "graphApiVersion": "v23.0",
        "node": "={{ $json.node }}",
        "edge": "media",
        "options": { "queryParameters": { "parameter": [{ "name": "caption", "value": "={{ $json.caption }}" }, { "name": "image_url", "value": "={{ $json.image_url }}" }, { "name": "media_type", "value": "STORIES" }] } }
      },
      "type": "n8n-nodes-base.facebookGraphApi",
      "typeVersion": 1,
      "position": [400, 600],
      "id": "c-fb-story-img",
      "name": "Container FB Story Image"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ 'https://graph.facebook.com/v23.0/' + $json.node + '/media' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendQuery": true,
        "queryParameters": { "parameters": [{ "name": "media_type", "value": "REELS" }, { "name": "video_url", "value": "={{ $json.video_url }}" }, { "name": "caption", "value": "={{ $json.caption }}" }, { "name": "cover_url", "value": "={{ $json.cover_image }}" }] },
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [400, 800],
      "id": "c-ig-reel",
      "name": "Container IG Reel"
    },
    {
      "parameters": {
        "httpRequestMethod": "POST",
